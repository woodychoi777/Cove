<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.soriseojae.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{PROJECT}}/src/server.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{PROJECT}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>SORISEOJAE_DATA_DIR</key>
    <string>{{PROJECT}}/data</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>{{PROJECT}}/data/server.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>{{PROJECT}}/data/server.stderr.log</string>
</dict>
</plist>
